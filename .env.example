# Public example only. Replace with a real key or an op:// reference in your private .env.
OPENAI_API_KEY=op://your-vault/your-item/openai-api-key

# Default embedding settings. The CLI also accepts explicit flags.
SEMANTIC_SEARCH_EMBEDDING_PROVIDER=openai
SEMANTIC_SEARCH_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_SEARCH_CACHE_DIR=.knowledge_cache

# Optional primary endpoint for an OpenAI-compatible embedding server.
# Defaults to the OpenAI SDK base URL when unset.
# SEMANTIC_SEARCH_BASE_URL=http://localhost:1234/v1

# Optional fallback endpoint used when the primary is unreachable.
# If set, SEMANTIC_SEARCH_FALLBACK_MODEL must also be set.
# SEMANTIC_SEARCH_FALLBACK_BASE_URL=http://localhost:1234/v1
# SEMANTIC_SEARCH_FALLBACK_MODEL=text-embedding-qwen3-embedding-8b

# Optional onboarding/debug feature. When enabled, each indexing run appends JSONL
# events with counts, duration, estimated tokens, and estimated cost. By default
# events are written to <cache-dir>/counter.jsonl. Set an absolute path only if
# you intentionally want a shared counter across multiple cache directories.
SEMANTIC_SEARCH_COUNTER_ENABLED=0
# SEMANTIC_SEARCH_COUNTER_PATH=/absolute/path/to/counter.jsonl
